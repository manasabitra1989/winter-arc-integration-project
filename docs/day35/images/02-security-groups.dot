edge [color="#456e9e", penwidth=1.6, arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#365578"];


rankdir=LR;
users [label="Internet users\n0.0.0.0/0",fillcolor="#e7f0ff"];
alb [label="ALB SG\nsg-0e08f8b68789a4fac\nIN 443 from internet\nOUT 8080 to App SG",fillcolor="#e8f2ff"];
